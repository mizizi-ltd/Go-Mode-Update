rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Users can read their own profile document
      allow read: if request.auth != null && (request.auth.token.email.lower() == userId.lower() || request.auth.uid == userId);
      // Deny direct client writes to prevent billing/entitlement tampering (Cloud Functions Admin SDK bypasses rules safely)
      allow write: if false;
    }
  }
}
